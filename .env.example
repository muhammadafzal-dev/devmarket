# Local development
DATABASE_URL=postgresql://devmarket:devmarket@localhost:5433/devmarket?schema=public
PORT=4000
WEB_URL=http://localhost:5173
NODE_ENV=development
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_ACCOUNT_COUNTRY=US

# Serverless deploy (Vercel) notes:
# - DATABASE_URL: use the Neon POOLED connection string (…-pooler…, add ?sslmode=require).
#   Provision it from the Vercel dashboard: Storage -> Neon (auto-injects this var).
# - WEB_URL: optional. On Vercel it auto-resolves to the production URL
#   (VERCEL_PROJECT_PRODUCTION_URL). Set it explicitly to allow a custom domain
#   or to keep preview deploys working.
# - NODE_ENV=production is set by Vercel automatically. Note: PAYMENT_MODE=demo is
#   REFUSED in production by design — a public deploy needs PAYMENT_MODE=stripe with
#   sk_test_ sandbox keys.
